<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>attendance-nguyenxuanphu-mvp</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
